# OpenAI credentials stay server-side. Never commit a populated .env file.
OPENAI_API_KEY=

# Model-role defaults checked against the current official OpenAI model catalog.
# Account-specific access is verified only during a controlled live test.
# Use Astra for the hardest judge/understanding/research work and less expensive
# GPT-5.6 roles for higher-volume generation.
THREADAWARE_TARGET_MODEL=gpt-5.6-sol
THREADAWARE_AUDITOR_MODEL=gpt-5.6-terra
THREADAWARE_JUDGE_MODEL=gpt-6-astra
THREADAWARE_UNDERSTANDING_MODEL=gpt-6-astra
THREADAWARE_SCENARIO_MODEL=gpt-5.6-terra
THREADAWARE_INSIGHTS_MODEL=gpt-6-astra
THREADAWARE_FALLBACK_MODEL=gpt-5.6-terra

# Project-side budget ledger for the approximately 10M granted API tokens.
# This is a configured ceiling, not an assumption that the OpenAI API exposes
# the grant balance directly.
THREADAWARE_TOTAL_TOKEN_BUDGET=10000000
THREADAWARE_MAX_TOKENS_PER_RUN=20000
THREADAWARE_MAX_BATCH_RUNS=25
